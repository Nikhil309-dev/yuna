# ====================================
# DISCORD BOT CONFIGURATION
# ====================================
DISCORD_TOKEN=
CLIENT_ID=your_client_id_here
PREFIX=.
OWNER_IDS=your_discord_user_id_here

# ====================================
# LAVALINK CONFIGURATION
# ====================================
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=9000
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# ====================================
# DISCORD LOG CHANNELS (Optional)
# Leave blank to disable a log destination.
# ====================================
# Optional — overrides the defaults baked into src/config/config.ts
LOG_GUILD_JOIN=1558795131602075799
LOG_GUILD_LEAVE=1558795134471245866
LOG_CMD_RUN=1558795136203231336
LOG_ERROR_LOGS=1558795139005153383
LOG_MUSIC_LOGS=1558795137897861160
LOG_ABUSE_BLACKLIST=1558795144394838026
LOG_CLUSTER_LAVALINK=1558795145590214748

# ====================================
# SPOTIFY API
# ====================================
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ====================================
# LAST.FM API (Optional)
# ====================================
LASTFM_API_KEY=your_lastfm_api_key

# ====================================
# BOT STATUS CONFIGURATION
# ====================================
STATUS_TEXT=.help | Yuna Music
STATUS_TYPE=online

# ====================================
# WEBHOOK LOGGING (Optional)
# ====================================
WEBHOOK_ENABLED=false
# Secret. Set your own Discord webhook URL here (keep out of git).
WEBHOOK_USERNAME=YUNA LOG
WEBHOOK_AVATAR_URL=https://i.imgur.com/yourimage.png
WEBHOOK_INFO_ENABLED=true
WEBHOOK_SUCCESS_ENABLED=true
WEBHOOK_WARNING_ENABLED=true
WEBHOOK_ERROR_ENABLED=true
WEBHOOK_DEBUG_ENABLED=false

# ====================================
# ASSETS
# ====================================
DEFAULT_TRACK_ARTWORK=https://raw.githubusercontent.com/bre4d777/Miku/refs/heads/main/images%20(1).jpeg
DEFAULT_THUMBNAIL=https://raw.githubusercontent.com/bre4d777/Miku/refs/heads/main/images%20(1).jpeg
HELP_THUMBNAIL=https://raw.githubusercontent.com/bre4d777/Miku/refs/heads/main/images%20(1).jpeg

# ====================================
# EXTERNAL LINKS
# ====================================
SUPPORT_SERVER_URL=https://discord.gg/tXzCwnwb

# ====================================
# ENVIRONMENT & DATABASE
# ====================================
NODE_ENV=production
DEBUG=false
DATABASE_PATH=./database/yuna.yuna
